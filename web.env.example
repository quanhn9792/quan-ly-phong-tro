# Cấu hình chạy web. Copy file này thành instance\web.env rồi sửa (instance\ không đưa lên git).
# Biến môi trường đặt sẵn trên máy luôn được ưu tiên hơn file này.

# --- Dùng trên điện thoại qua tunnel (Tailscale Funnel / Cloudflare Tunnel) ---
# TRUST_PROXY=1
# PUBLIC_URL=https://ten-may.tail1234.ts.net

# --- SQL Server (mặc định dùng LocalDB + Windows Authentication) ---
# MSSQL_SERVER=(localdb)\QuanLyPhongTro2025
# MSSQL_DATABASE=QuanLyPhongTro
# MSSQL_USERNAME=
# MSSQL_PASSWORD=

# --- Cổng web ---
# PORT=5000

# --- App Android đóng gói bằng PWABuilder (tùy chọn) ---
# ANDROID_PACKAGE=
# ANDROID_CERT_SHA256=
